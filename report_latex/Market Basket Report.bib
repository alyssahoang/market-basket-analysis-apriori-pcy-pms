@incollection{srikantMiningSequentialPatterns1996,
  title = {Mining Sequential Patterns: {{Generalizations}} and Performance Improvements},
  shorttitle = {Mining Sequential Patterns},
  booktitle = {Advances in {{Database Technology}} — {{EDBT}} '96},
  author = {Srikant, Ramakrishnan and Agrawal, Rakesh},
  editor = {Apers, Peter and Bouzeghoub, Mokrane and Gardarin, Georges},
  date = {1996},
  volume = {1057},
  pages = {1--17},
  publisher = {Springer Berlin Heidelberg},
  location = {Berlin, Heidelberg},
  doi = {10.1007/BFb0014140},
  url = {http://link.springer.com/10.1007/BFb0014140},
  urldate = {2026-03-16},
  abstract = {The problem of mining sequential patterns was recently introduced in [3]. We are given a database of sequences, where each sequence is a list of transactions ordered by transaction-time, and each transaction is a set of items. The problem is to discover all sequential patterns with a user-speci ed minimum support, where the support of a pattern is the number of data-sequences that contain the pattern. An example of a sequential pattern is \textbackslash 5\% of customers bought `Foundation' and `Ringworld' in one transaction, followed by `Second Foundation' in a later transaction". We generalize the problem as follows. First, we add time constraints that specify a minimum and/or maximum time period between adjacent elements in a pattern. Second, we relax the restriction that the items in an element of a sequential pattern must come from the same transaction, instead allowing the items to be present in a set of transactions whose transaction-times are within a user-speci ed time window. Third, given a user-de ned taxonomy (is-a hierarchy) on items, we allow sequential patterns to include items across all levels of the taxonomy.},
  isbn = {978-3-540-61057-1 978-3-540-49943-5},
  langid = {english},
  note = {Series Title: Lecture Notes in Computer Science},
  file = {C:\Users\HP\Zotero\storage\BM4AKXGQ\Srikant and Agrawal - 1996 - Mining sequential patterns Generalizations and performance improvements.pdf}
}

